{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kentch2013/Apps4Kids/preschool-curriculum/schema.json",
  "title": "Apps4Kids Preschool Visual Curriculum Domain File",
  "description": "Strict visual-only preschool curriculum domain dataset with voice-recall metadata for offline voice games.",
  "type": "object",
  "required": ["set", "domain", "version", "items"],
  "additionalProperties": false,
  "properties": {
    "set": {
      "type": "string",
      "enum": ["core", "comprehensive"]
    },
    "domain": {
      "type": "string",
      "enum": [
        "letters",
        "numbers_quantities",
        "symbols_icons",
        "shapes_spatial",
        "colors_measurement",
        "time_money",
        "science_nature",
        "social_community",
        "emotions_everyday"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/curriculumItem"
      }
    }
  },
  "$defs": {
    "curriculumItem": {
      "type": "object",
      "required": [
        "id",
        "label",
        "domain",
        "category",
        "tier",
        "visual_type",
        "display_token",
        "visual_prompt",
        "audio_prompt",
        "standard_refs",
        "distractor_group",
        "in_core"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "enum": [
            "letters",
            "numbers_quantities",
            "symbols_icons",
            "shapes_spatial",
            "colors_measurement",
            "time_money",
            "science_nature",
            "social_community",
            "emotions_everyday"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 2
        },
        "tier": {
          "type": "integer",
          "enum": [1, 2, 3, 4]
        },
        "visual_type": {
          "type": "string",
          "enum": [
            "letter_glyph",
            "numeral_glyph",
            "quantity_visual",
            "symbol_glyph",
            "shape_geometry",
            "color_swatch",
            "pattern_sequence",
            "clock_visual",
            "currency_visual",
            "diagram_illustration",
            "pictogram_sign",
            "comparison_pair"
          ]
        },
        "display_token": {
          "type": ["string", "null"]
        },
        "visual_prompt": {
          "type": "string",
          "minLength": 12
        },
        "audio_prompt": {
          "type": "string",
          "minLength": 5
        },
        "standard_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "distractor_group": {
          "type": "string",
          "minLength": 2
        },
        "in_core": {
          "type": "boolean"
        },
        "accepted_utterances": {
          "type": "array",
          "description": "Normalized lowercase, punctuation-stripped spoken answers accepted as correct matches (aligned with web-poc/spike-voice/vocab-matcher.js).",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?: [a-z0-9]+)*$"
          }
        },
        "voice_recall_mode": {
          "type": "string",
          "description": "Indicates how an item participates in offline voice-only gameplay.",
          "enum": [
            "direct_word",
            "synonym_set",
            "confusable_phoneme",
            "guided_only"
          ]
        },
        "confusable_with": {
          "type": "array",
          "description": "Optional list of curriculum item IDs that must not spawn simultaneously on screen with this item.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"
          }
        }
      }
    }
  }
}
